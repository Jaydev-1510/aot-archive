{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "aot-archive",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "545a57beda9b484d9d461468cee5d9ea"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aot-archive",
			"database_id": "071f0c5f-cf6e-4ffb-af55-53ea4d6a33a6"
		}
	]
}