---
import BaseLayout from "@/layouts/base.astro";
import openingVideo from "@/assets/videos/opening.webm";
import openingSong from "@/assets/audios/opening.mp3";
import SurveyCorpsLogo from "@/assets/images/surveyCorpsLogo.svg";
import { MoveRight } from "@lucide/astro";

export const prerender = true;
---

<BaseLayout>
  <div
    id="intro-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="archive-title"
    aria-describedby="archive-description"
    class="bg-archive-black/95 fixed inset-0 z-50 flex items-center justify-center overflow-y-auto px-4 py-8 opacity-0 backdrop-blur-md"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-linear(circle_at_center,transparent_0%,rgba(0,0,0,0.55)_100%)]"
    >
    </div>

    <section
      class="border-archive-800 bg-archive-950 relative w-full max-w-2xl overflow-hidden border shadow-[0_25px_80px_rgba(0,0,0,0.7)]"
    >
      <div
        aria-hidden="true"
        class="via-archive-500 h-px w-full bg-linear-to-r from-transparent to-transparent"
      >
      </div>
      <div
        class="absolute inset-0 z-0 bg-no-repeat opacity-5"
        style={`background-image: url(${SurveyCorpsLogo.src});`}
      >
      </div>
      <div class="relative px-7 py-8 sm:px-12 sm:py-11">
        <header>
          <div class="flex items-center justify-between gap-4">
            <p
              class="tracking-classified text-archive-500 shrink-0 text-[11px] font-medium uppercase"
            >
              Survey Corps Archives
            </p>
            <span class="bg-archive-800 h-px flex-1"></span>
            <p
              class="text-archive-600 hover:text-paper-100 hidden text-[9px] tracking-[0.3em] uppercase transition-colors duration-700 sm:block"
              aria-hidden="true"
            >
              ARCHIVE // 001
            </p>
          </div>

          <h1
            id="archive-title"
            class="text-paper-100 mt-6 text-center font-serif text-4xl sm:text-6xl"
          >
            Attack on Titan
          </h1>

          <p
            class="text-archive-500 mt-2 text-center text-lg tracking-wide italic"
            lang="ja"
          >
            進撃の巨人 アーカイブ
          </p>
        </header>

        <div aria-hidden="true" class="my-7 flex items-center gap-3">
          <span class="bg-archive-800 h-px flex-1"></span>

          <span
            class="text-archive-600 hover:text-paper-100 text-[9px] tracking-[0.35em] uppercase transition-colors duration-700"
          >
            Classified Record
          </span>

          <span class="bg-archive-800 h-px flex-1"></span>
        </div>

        <div
          id="archive-description"
          class="text-paper-300 space-y-4 text-sm leading-7 sm:text-[15px]"
        >
          <p>
            An archival reconstruction of the world of
            <span class="text-paper-200"> Attack on Titan</span> — its people, bloodlines,
            Titans, factions, events, locations, and history.
          </p>

          <p>
            Humanity's history has been reconstructed from official records,
            animation, music, and visual references. Proceed only when prepared
            to enter the world beyond the Walls.
          </p>
        </div>

        <aside
          class="border-brass-900/30 bg-brass-950/10 mt-7 border px-4 py-4 backdrop-blur-2xl"
          aria-label="Audio experience notice"
        >
          <div>
            <div>
              <p
                class="text-brass-500 text-[12px] font-semibold tracking-[0.3em] uppercase"
              >
                Archive Notice
              </p>

              <p class="text-archive-500 mt-2 text-sm leading-6">
                The archive may begin with an atmospheric audio sequence.
                Headphones are recommended. Sound can be enabled or disabled at
                any time.
              </p>
            </div>
          </div>
        </aside>

        <button
          id="start-btn"
          type="button"
          class="group border-archive-600 bg-paper-100 hover:border-paper-300 hover:bg-paper-50 focus-visible:ring-paper-300 focus-visible:ring-offset-archive-950 mt-8 flex w-full items-center justify-center gap-2 border px-5 py-3.5 text-xs font-semibold tracking-[0.3em] text-black uppercase transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
        >
          <span>Enter the Archive</span>

          <MoveRight
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110"
          />
        </button>

        <footer
          class="text-archive-600 mt-6 flex flex-col gap-2 text-[9px] tracking-[0.25em] uppercase sm:flex-row sm:items-center sm:justify-between"
        >
          <span class="hover:text-paper-100 transition-colors duration-700"
            >Survey Corps Intelligence Division</span
          >
          <span class="hover:text-paper-100 transition-colors duration-700"
            >Records Reconstructed</span
          >
        </footer>
      </div>

      <div
        aria-hidden="true"
        class="via-archive-700 h-px w-full bg-linear-to-r from-transparent to-transparent"
      >
      </div>
    </section>
  </div>
  <video
    id="openingVideo"
    src={openingVideo}
    muted
    playsinline
    preload="auto"
    class="absolute z-40 my-auto h-auto w-screen opacity-0"></video>
  <audio id="openingSong" src={openingSong} preload="auto"></audio>
  <main
    id="main-content"
    class="relative z-40 flex min-h-dvh items-center justify-center bg-cover bg-center px-4 opacity-0"
  >
    <div class="text-paper-200 mx-auto w-full max-w-4xl text-center">
      <h1 class="font-serif text-3xl sm:text-5xl md:text-7xl">
        Attack on Titan Archives
      </h1>
      <div class="mt-4 flex items-center justify-center gap-5">
        <div class="h-px max-w-24 flex-1 bg-white/40"></div>
        <h2 class="font-sans text-sm sm:text-2xl">進撃の巨人 アーカイブ</h2>
        <div class="h-px max-w-24 flex-1 bg-white/40"></div>
      </div>
    </div>
  </main>
  <script>
    const modal = document.getElementById("intro-modal") as HTMLElement;
    const hero = document.getElementById("main-content") as HTMLElement;
    const button = document.getElementById("start-btn") as HTMLButtonElement;
    const video = document.getElementById("openingVideo") as HTMLVideoElement;
    const music = document.getElementById("openingSong") as HTMLAudioElement;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (localStorage.getItem("aot-intro-seen") || prefersReducedMotion) {
      modal?.remove();
      hero?.classList.add("fade-in");
      document.dispatchEvent(new CustomEvent("archive-sequence-complete"));
    } else {
      modal?.classList.add("fade-in");
      button?.focus();

      // Focus trap within modal
      modal?.addEventListener("keydown", (e) => {
        if (e.key === "Tab") {
          e.preventDefault();
          button?.focus();
        }
      });

      button?.addEventListener("click", async () => {
        localStorage.setItem("aot-intro-seen", "1");
        button.disabled = true;

        if (prefersReducedMotion) {
          modal.remove();
          hero.classList.add("fade-in");
          document.dispatchEvent(new CustomEvent("archive-sequence-complete"));
          return;
        }

        video.currentTime = 0;
        music.currentTime = 0;
        video.muted = true;
        video.playsInline = true;
        modal.classList.remove("fade-in");
        modal.classList.add("fade-out");
        try {
          await Promise.all([video.play(), music.play()]);
        } catch (error) {
          console.error("Failed to start archive sequence:", error);
          try {
            await video.play();
          } catch (videoError) {
            console.error("Video playback failed:", videoError);
          }
        }
        video.classList.add("fade-in");
        modal.addEventListener(
          "transitionend",
          () => {
            modal.remove();
          },
          { once: true },
        );
        video.addEventListener(
          "ended",
          () => {
            video.classList.remove("fade-in");
            video.classList.add("fade-out");
            hero.classList.add("fade-in");
            document.dispatchEvent(
              new CustomEvent("archive-sequence-complete"),
            );
            video.addEventListener(
              "transitionend",
              () => {
                video.remove();
              },
              { once: true },
            );
          },
          { once: true },
        );
      });
    }
  </script>
</BaseLayout>
