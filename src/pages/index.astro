---
import BaseLayout from "@/layouts/base.astro";
import openingVideo from "@/assets/videos/opening.webm";
import openingSong from "@/assets/audios/opening.mp3";
import SurveyCorpsLogo from "@/assets/images/surveyCorpsLogo.svg";

export const prerender = true;
---

<BaseLayout>
  <div
    id="intro-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="archive-title"
    aria-describedby="archive-description"
    class="fixed inset-0 z-50 flex items-center justify-center overflow-y-auto bg-[#050505]/95 px-4 py-8 opacity-0 backdrop-blur-md"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-[radial-linear(circle_at_center,transparent_0%,rgba(0,0,0,0.55)_100%)]"
    >
    </div>

    <section
      class="relative w-full max-w-2xl overflow-hidden border border-stone-800 bg-[#0b0908] shadow-[0_25px_80px_rgba(0,0,0,0.7)]"
    >
      <div
        aria-hidden="true"
        class="h-px w-full bg-linear-to-r from-transparent via-stone-500 to-transparent"
      >
      </div>
      <div
        class="absolute inset-0 z-0 bg-no-repeat opacity-5"
        style={`background-image: url(${SurveyCorpsLogo.src});`}
      >
      </div>
      <div class="relative px-7 py-8 sm:px-12 sm:py-11">
        <header>
          <div class="flex items-center justify-between gap-4">
            <p
              class="tracking-classified shrink-0 text-[11px] font-medium text-stone-500 uppercase"
            >
              Survey Corps Archives
            </p>
            <span class="h-px flex-1 bg-stone-800"></span>
            <p
              class="hidden text-[9px] tracking-[0.3em] text-stone-700 uppercase transition-colors duration-700 hover:text-zinc-200 sm:block"
              aria-hidden="true"
            >
              ARCHIVE // 001
            </p>
          </div>

          <h1
            id="archive-title"
            class="mt-6 text-center font-serif text-4xl text-stone-100 sm:text-6xl"
          >
            Attack on Titan
          </h1>

          <p
            class="mt-2 text-center text-lg tracking-wide text-stone-500 italic"
            lang="ja"
          >
            進撃の巨人 アーカイブ
          </p>
        </header>

        <div aria-hidden="true" class="my-7 flex items-center gap-3">
          <span class="h-px flex-1 bg-stone-800"></span>

          <span
            class="text-[9px] tracking-[0.35em] text-stone-700 uppercase transition-colors duration-700 hover:text-zinc-200"
          >
            Classified Record
          </span>

          <span class="h-px flex-1 bg-stone-800"></span>
        </div>

        <div
          id="archive-description"
          class="space-y-4 text-sm leading-7 text-stone-400 sm:text-[15px]"
        >
          <p>
            An archival reconstruction of the world of
            <span class="text-stone-200"> Attack on Titan</span> — its people, bloodlines,
            Titans, factions, events, locations, and history.
          </p>

          <p>
            Humanity's history has been reconstructed from official records,
            animation, music, and visual references. Proceed only when prepared
            to enter the world beyond the Walls.
          </p>
        </div>

        <aside
          class="mt-7 border border-amber-900/30 bg-amber-950/10 px-4 py-4 backdrop-blur-2xl"
          aria-label="Audio experience notice"
        >
          <div>
            <div>
              <p
                class="text-[12px] font-semibold tracking-[0.3em] text-amber-500 uppercase"
              >
                Archive Notice
              </p>

              <p class="mt-2 text-sm leading-6 text-stone-500">
                The archive may begin with an atmospheric audio sequence.
                Headphones are recommended. Sound can be enabled or disabled at
                any time.
              </p>
            </div>
          </div>
        </aside>

        <button
          id="start-btn"
          type="button"
          class="group mt-8 flex w-full items-center justify-center gap-2 border border-stone-600 bg-stone-100 px-5 py-3.5 text-xs font-semibold tracking-[0.3em] text-black uppercase transition-all duration-300 hover:border-stone-300 hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0b0908]"
        >
          <span>Enter the Archive</span>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:scale-110"
            ><path d="M18 8L22 12L18 16"></path><path d="M2 12H22"></path></svg
          >
        </button>

        <footer
          class="mt-6 flex flex-col gap-2 text-[9px] tracking-[0.25em] text-stone-700 uppercase sm:flex-row sm:items-center sm:justify-between"
        >
          <span class="transition-colors duration-700 hover:text-zinc-200"
            >Survey Corps Intelligence Division</span
          >
          <span class="transition-colors duration-700 hover:text-zinc-200"
            >Records Reconstructed</span
          >
        </footer>
      </div>

      <div
        aria-hidden="true"
        class="h-px w-full bg-linear-to-r from-transparent via-stone-700 to-transparent"
      >
      </div>
    </section>
  </div>
  <video
    id="openingVideo"
    src={openingVideo}
    muted
    playsinline
    preload="auto"
    class="absolute z-40 my-auto h-auto w-screen opacity-0"></video>
  <audio id="openingSong" src={openingSong} preload="auto"></audio>
  <main
    id="hero"
    class="relative z-40 flex min-h-dvh items-center justify-center bg-cover bg-center opacity-0"
  >
    <div class="w-fit">
      <h1 class="font-serif text-4xl whitespace-nowrap sm:text-7xl">
        Attack on Titan Archives
      </h1>
      <div class="flex items-center gap-5">
        <div class="h-px flex-1 bg-white"></div>
        <h2 class="text-md font-sans whitespace-nowrap sm:text-2xl">
          進撃の巨人 アーカイブ
        </h2>
        <div class="h-px flex-1 bg-white"></div>
      </div>
    </div>
  </main>
  <script>
    const modal = document.getElementById("intro-modal") as HTMLElement;
    const hero = document.getElementById("hero") as HTMLElement;
    const button = document.getElementById("start-btn") as HTMLButtonElement;
    const video = document.getElementById("openingVideo") as HTMLVideoElement;
    const music = document.getElementById("openingSong") as HTMLAudioElement;

    if (localStorage.getItem("aot-intro-seen")) {
      modal.remove();
      hero.classList.add("fade-in");
      document.dispatchEvent(new CustomEvent("archive-sequence-complete"));
    } else {
      modal.classList.add("fade-in");
      button.addEventListener("click", async () => {
        localStorage.setItem("aot-intro-seen", "1");
        button.disabled = true;
        video.currentTime = 0;
        music.currentTime = 0;
        video.muted = true;
        video.playsInline = true;
        modal.classList.remove("fade-in");
        modal.classList.add("fade-out");
        try {
          await Promise.all([video.play(), music.play()]);
        } catch (error) {
          console.error("Failed to start archive sequence:", error);
          try {
            await video.play();
          } catch (videoError) {
            console.error("Video playback failed:", videoError);
          }
        }
        video.classList.add("fade-in");
        modal.addEventListener(
          "transitionend",
          () => {
            modal.remove();
          },
          { once: true },
        );
        video.addEventListener(
          "ended",
          () => {
            video.classList.remove("fade-in");
            video.classList.add("fade-out");
            hero.classList.add("fade-in");
            document.dispatchEvent(
              new CustomEvent("archive-sequence-complete"),
            );
            video.addEventListener(
              "transitionend",
              () => {
                video.remove();
              },
              { once: true },
            );
          },
          { once: true },
        );
      });
    }
  </script>
  <style>
    .fade-out {
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    .fade-in {
      opacity: 1;
      transition: opacity 0.5s ease;
    }
  </style>
</BaseLayout>
