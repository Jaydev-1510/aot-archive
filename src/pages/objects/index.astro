---
import { createDb } from "@/database";
import { env } from "cloudflare:workers";
import { getObjects } from "@/database/queries/entities";
import ArchiveIndex, {
  type FilterConfig,
  type SortOption,
} from "@/components/archive/ArchiveIndex.astro";

const url = new URL(Astro.request.url);
const q = url.searchParams.get("q") || "";
const objectType = url.searchParams.get("type") || "all";
const sort = (url.searchParams.get("sort") as "name" | "type" | "id") || "name";
const order = (url.searchParams.get("order") as "asc" | "desc") || "asc";
const page = Math.max(1, parseInt(url.searchParams.get("page") || "1", 10));
const pageSize = 48;
const offset = (page - 1) * pageSize;

let items: any[] = [];
let total = 0;

if (env && env.DB) {
  const db = createDb(env.DB);
  const res = await getObjects(db, {
    search: q,
    objectType: objectType !== "all" ? objectType : undefined,
    sort,
    order,
    limit: pageSize,
    offset,
  });
  items = res.items;
  total = res.total;
}

const filters: FilterConfig[] = [
  {
    key: "type",
    label: "Object Type",
    currentValue: objectType,
    options: [
      { value: "equipment", label: "Equipment" },
      { value: "weapon", label: "Weaponry" },
      { value: "artifact", label: "Artifact" },
      { value: "document", label: "Classified Document" },
      { value: "other", label: "Other" },
    ],
  },
];

const sortOptions: SortOption[] = [
  { value: "name", label: "Object Name" },
  { value: "type", label: "Material Classification" },
  { value: "id", label: "Record ID" },
];

const cardItems = items.map((o) => ({
  id: o.id,
  type: "object",
  name: o.name,
  subtitle: (o.objectType || "OBJECT").toUpperCase(),
  japaneseName: null,
  status: null,
  code: o.id.replace("object/", "").slice(0, 4).toUpperCase(),
}));
---

<ArchiveIndex
  title="Objects"
  designation="MILITARY EQUIPMENT & ARTIFACT REPOSITORY"
  description="Technical schematics and historical inventory of omni-directional mobility gear, Thunder Spears, syringes, and historical artifacts."
  baseRoute="/objects"
  items={cardItems}
  totalCount={total}
  filters={filters}
  sortOptions={sortOptions}
  currentSort={sort}
  currentOrder={order}
  currentQuery={q}
  currentPage={page}
  pageSize={pageSize}
/>
