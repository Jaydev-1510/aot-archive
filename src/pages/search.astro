---
import BaseLayout from "@/layouts/base.astro";
import { createDb } from "@/database";
import { env } from "cloudflare:workers";
import { searchArchive, type SearchFilterType } from "@/database/queries/search";
import { Search, ChevronLeft, ChevronRight } from "@lucide/astro";

import Container from "@/components/ui/Container.astro";
import ArchiveBreadcrumbs from "@/components/archive/ArchiveBreadcrumbs.astro";
import ArchiveHeader from "@/components/archive/ArchiveHeader.astro";
import EntityCard from "@/components/entity/EntityCard.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import ErrorState from "@/components/ui/ErrorState.astro";



const url = new URL(Astro.request.url);
const query = url.searchParams.get("q") || "";
const rawType = url.searchParams.get("type") || "all";
const validTypes = ["all", "people", "titans", "events", "locations", "factions", "objects", "abilities", "families"];
const typeFilter = validTypes.includes(rawType) ? (rawType as SearchFilterType) : "all";

const pageParam = url.searchParams.get("page");
let page = pageParam ? parseInt(pageParam, 10) : 1;
if (isNaN(page) || page < 1) page = 1;

const LIMIT = 20;

let results: any[] = [];
let total = 0;
let error: string | null = null;

if (query.trim().length > 0) {
  try {
    if (env && env.DB) {
      const db = createDb(env.DB);
      const res = await searchArchive(db, query, LIMIT, typeFilter, page);
      results = res.results;
      total = res.total;
    } else {
      error = "Search unavailable: Database binding missing.";
    }
  } catch (err) {
    console.error("Search error:", err);
    error = "An error occurred while searching the archive.";
  }
}

const totalPages = Math.ceil(total / LIMIT);

function getPageUrl(newPage: number) {
  const newUrl = new URL(url.toString());
  newUrl.searchParams.set("page", newPage.toString());
  return newUrl.toString();
}

const pageTitle = query
  ? `Search: ${query} — Survey Corps Archives`
  : `Archive Search — Survey Corps Archives`;
const pageDescription =
  "Search the comprehensive Attack on Titan knowledge archive.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Container class="pt-8 pb-24">
    <ArchiveBreadcrumbs
      items={[
        { label: "Archive", href: "/" },
        { label: "Search" },
      ]}
    />

    <ArchiveHeader 
      title="Archive Discovery" 
      description="Query the complete classified archival database" 
    />

    <div class="mb-12 border border-archive-800 bg-archive-900/40 p-4 sm:p-6 rounded-sm shadow-sm relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[100%_4px] opacity-20" aria-hidden="true"></div>

      <form action="/search" method="get" class="relative z-10 flex flex-col gap-6" role="search">
        <div class="relative flex items-center">
          <label for="search-input" class="sr-only">Query archive index</label>
          <Search size={24} aria-hidden="true" class="text-archive-500 absolute left-4" />
          <input
            type="text"
            id="search-input"
            name="q"
            value={query}
            placeholder="Search records by name, designation, or alias..."
            class="bg-archive-950/80 border-archive-700 text-paper-50 focus:border-brass-600/50 focus-visible:ring-brass-600/50 w-full rounded-sm border pl-14 pr-32 py-4 text-xl sm:text-lg transition-colors focus:outline-none focus-visible:ring-2 shadow-inner"
            autofocus={!query}
          />
          <button
            type="submit"
            aria-label="Submit search"
            class="tracking-classified text-paper-200 bg-archive-800 hover:bg-brass-700 hover:text-paper-50 border border-archive-700 hover:border-brass-600 focus-visible:ring-brass-600/50 absolute right-3 h-10 px-4 rounded-sm font-mono text-xs uppercase transition-colors focus:outline-none focus-visible:ring-2"
          >
            Query
          </button>
        </div>

        {/* Filters */}
        <fieldset class="flex flex-wrap items-center gap-3">
          <legend class="sr-only">Filter by record type</legend>
          <span class="text-archive-500 tracking-military text-xs uppercase font-mono mr-2">Classification:</span>
          {validTypes.map(t => (
            <label class="relative cursor-pointer">
              <input 
                type="radio" 
                name="type" 
                value={t} 
                checked={t === typeFilter} 
                class="sr-only peer"
                onchange="this.form.submit()"
              />
              <span class="inline-flex h-8 items-center justify-center rounded-sm border px-3 text-xs font-mono uppercase tracking-widest transition-colors
                border-archive-800 bg-archive-900/50 text-archive-400
                peer-hover:bg-archive-800 peer-hover:text-paper-200
                peer-checked:border-brass-600/60 peer-checked:bg-brass-900/20 peer-checked:text-brass-400
                peer-focus-visible:ring-2 peer-focus-visible:ring-brass-600/50">
                {t}
              </span>
            </label>
          ))}
        </fieldset>
      </form>
    </div>

    <div aria-live="polite" class="min-h-100">
      {error ? (
        <ErrorState 
          title="Query Failed" 
          message={error} 
        />
      ) : query.trim() === "" ? (
        <EmptyState 
          title="Awaiting Query" 
          description="Enter a search term above to scan the archive index for people, titans, events, and other classified records." 
          icon="search"
        />
      ) : results.length === 0 ? (
        <EmptyState 
          title="No Records Found" 
          description={`No matches in the current database for "${query}"${typeFilter !== "all" ? ` under classification '${typeFilter}'` : ""}.`} 
          icon="search"
        >
          <a 
            href="/search" 
            class="mt-6 inline-flex h-10 items-center justify-center rounded-sm border border-archive-700 bg-archive-800 px-6 font-mono text-xs uppercase tracking-widest text-paper-200 transition-colors hover:border-archive-600 hover:bg-archive-700 hover:text-paper-50"
          >
            Reset Query
          </a>
        </EmptyState>
      ) : (
        <div class="space-y-8">
          <div class="flex items-center justify-between border-b border-archive-800/80 pb-4">
            <h2 class="text-paper-200 font-serif text-2xl">
              Search Results
            </h2>
            <div class="text-archive-500 font-mono text-xs uppercase tracking-widest">
              Found {total} records
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {results.map((result) => (
              <EntityCard 
                id={result.entityId}
                type={result.entityType}
                name={result.name}
                subtitle={result.summary || undefined}
                badges={[result.entityType]}
              />
            ))}
          </div>

          {totalPages > 1 && (
            <nav
              aria-label="Pagination"
              class="border-archive-800/80 mt-12 flex flex-col items-center justify-between gap-4 border-t pt-6 sm:flex-row"
            >
              <div class="text-archive-500 font-mono text-xs">
                PAGE {page} / {totalPages}
              </div>

              <div class="flex items-center gap-2">
                {page > 1 ? (
                  <a
                    href={getPageUrl(page - 1)}
                    class="border-archive-700 bg-archive-900/60 tracking-military text-paper-200 hover:border-archive-600 hover:bg-archive-800/80 hover:text-paper-50 focus-visible:ring-brass-600/50 inline-flex min-h-11 items-center gap-2 rounded-sm border px-4 py-2 font-mono text-xs uppercase transition-colors focus:outline-none focus-visible:ring-2"
                  >
                    <ChevronLeft class="h-4 w-4" aria-hidden="true" />
                    <span>Previous</span>
                  </a>
                ) : (
                  <span class="border-archive-900 bg-archive-950/40 tracking-military text-archive-600 inline-flex min-h-11 cursor-not-allowed items-center gap-2 rounded-sm border px-4 py-2 font-mono text-xs uppercase opacity-40">
                    <ChevronLeft class="h-4 w-4" aria-hidden="true" />
                    <span>Previous</span>
                  </span>
                )}

                {page < totalPages ? (
                  <a
                    href={getPageUrl(page + 1)}
                    class="border-archive-700 bg-archive-900/60 tracking-military text-paper-200 hover:border-archive-600 hover:bg-archive-800/80 hover:text-paper-50 focus-visible:ring-brass-600/50 inline-flex min-h-11 items-center gap-2 rounded-sm border px-4 py-2 font-mono text-xs uppercase transition-colors focus:outline-none focus-visible:ring-2"
                  >
                    <span>Next</span>
                    <ChevronRight class="h-4 w-4" aria-hidden="true" />
                  </a>
                ) : (
                  <span class="border-archive-900 bg-archive-950/40 tracking-military text-archive-600 inline-flex min-h-11 cursor-not-allowed items-center gap-2 rounded-sm border px-4 py-2 font-mono text-xs uppercase opacity-40">
                    <span>Next</span>
                    <ChevronRight class="h-4 w-4" aria-hidden="true" />
                  </span>
                )}
              </div>
            </nav>
          )}
        </div>
      )}
    </div>
  </Container>
</BaseLayout>
