<script>
  const nav = document.getElementById("global-nav");
  const navBg = document.getElementById("nav-bg");
  const searchTrigger = document.getElementById("search-trigger");
  const searchDialog = document.getElementById("search-dialog");
  const searchBackdrop = document.getElementById("search-backdrop");
  const searchPanel = document.getElementById("search-panel");
  const searchInput = document.getElementById("search-input");
  const searchClose = document.getElementById("search-close");
  const mobileMenuTrigger = document.getElementById("mobile-menu-trigger");
  const mobileMenu = document.getElementById("mobile-menu");

  let isSearchOpen = false;
  let isMobileMenuOpen = false;
  const isHomepage = window.location.pathname === "/";

  if (isHomepage && !localStorage.getItem("aot-intro-seen")) {
    nav?.classList.add("opacity-0", "pointer-events-none", "-translate-y-20");
    document.addEventListener("archive-sequence-complete", () => {
      nav?.classList.remove(
        "opacity-0",
        "pointer-events-none",
        "-translate-y-20",
      );
    });
  } else {
    nav?.classList.remove(
      "opacity-0",
      "pointer-events-none",
      "-translate-y-20",
    );
  }

  function handleScroll() {
    if (window.scrollY > 20) {
      navBg?.classList.remove("opacity-0");
      navBg?.classList.add("opacity-90");
      nav?.classList.add("backdrop-blur-lg");
    } else {
      navBg?.classList.remove("opacity-90");
      navBg?.classList.add("opacity-0");
      nav?.classList.remove("backdrop-blur-lg");
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  function openSearch() {
    isSearchOpen = true;
    searchDialog?.classList.remove("opacity-0", "pointer-events-none");
    searchPanel?.classList.remove("scale-200");
    searchPanel?.classList.remove("opacity-0");
    setTimeout(() => searchInput?.focus(), 50);
    document.body.style.overflow = "hidden";
  }

  function closeSearch() {
    isSearchOpen = false;
    searchDialog?.classList.add("opacity-0", "pointer-events-none");
    searchPanel?.classList.add("scale-200");
    searchPanel?.classList.add("opacity-0");
    document.body.style.overflow = "";
  }

  searchTrigger?.addEventListener("click", openSearch);
  searchClose?.addEventListener("click", closeSearch);
  searchBackdrop?.addEventListener("click", closeSearch);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      isSearchOpen ? closeSearch() : openSearch();
    }
    if (
      e.key === "/" &&
      !isSearchOpen &&
      document.activeElement?.tagName !== "INPUT"
    ) {
      e.preventDefault();
      openSearch();
    }
    if (e.key === "Escape") {
      if (isSearchOpen) closeSearch();
      if (isMobileMenuOpen) closeMobileMenu();
    }
  });

  function toggleMobileMenu() {
    isMobileMenuOpen = !isMobileMenuOpen;
    if (isMobileMenuOpen) {
      mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
      mobileMenuTrigger?.setAttribute("aria-expanded", "true");

      if (mobileMenuTrigger) {
        mobileMenuTrigger.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
      }
      document.body.style.overflow = "hidden";
    } else {
      closeMobileMenu();
    }
  }

  function closeMobileMenu() {
    isMobileMenuOpen = false;
    mobileMenu?.classList.add("opacity-0", "pointer-events-none");
    mobileMenuTrigger?.setAttribute("aria-expanded", "false");

    if (mobileMenuTrigger) {
      mobileMenuTrigger.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>';
    }
    document.body.style.overflow = "";
  }

  mobileMenuTrigger?.addEventListener("click", toggleMobileMenu);

  const searchResultsList = document.getElementById("search-results-list");
  const searchEmptyState = document.getElementById("search-empty-state");
  const searchLoadingState = document.getElementById("search-loading-state");
  const searchNoResults = document.getElementById("search-no-results");
  let searchTimeout: ReturnType<typeof setTimeout> | null = null;
  let currentSelectedIndex = -1;

  function updateSearchUI(state: string) {
    searchEmptyState?.classList.add("hidden");
    searchLoadingState?.classList.add("hidden");
    searchNoResults?.classList.add("hidden");
    searchResultsList?.classList.add("hidden");

    if (state === "empty") searchEmptyState?.classList.remove("hidden");
    else if (state === "loading")
      searchLoadingState?.classList.remove("hidden");
    else if (state === "no-results")
      searchNoResults?.classList.remove("hidden");
    else if (state === "results") searchResultsList?.classList.remove("hidden");
  }

  function getEntityRoute(type: string, id: string) {
    switch (type) {
      case "person":
        return `/people/${id}`;
      case "titan":
        return `/titans/${id}`;
      case "event":
        return `/events/${id}`;
      case "location":
        return `/locations/${id}`;
      case "faction":
        return `/factions/${id}`;
      default:
        return `/${type}s/${id}`;
    }
  }

  async function performSearch(query: string) {
    if (!query.trim()) {
      updateSearchUI("empty");
      if (searchResultsList) searchResultsList.innerHTML = "";
      return;
    }

    updateSearchUI("loading");
    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
      if (!res.ok) throw new Error("Search failed");
      const data = (await res.json()) as { results: any[] };
      const results = data.results || [];

      if (results.length === 0) {
        updateSearchUI("no-results");
        if (searchResultsList) searchResultsList.innerHTML = "";
      } else {
        currentSelectedIndex = -1;
        if (searchResultsList) {
          searchResultsList.innerHTML = results
            .map(
              (result: any) => `
            <li role="option" aria-selected="false" class="search-result-item group flex items-center justify-between p-3 border border-transparent hover:border-archive-700/50 hover:bg-archive-900/40 rounded-sm cursor-pointer transition-colors" data-href="${getEntityRoute(result.entityType, result.entityId)}">
              <span class="font-serif text-2xl text-paper-200 group-hover:text-paper-50 transition-colors pointer-events-none">${result.name}</span>
              <span class="text-[9px] tracking-classified uppercase text-archive-500 group-hover:text-paper-300 transition-colors pointer-events-none">${result.entityType}</span>
            </li>
          `,
            )
            .join("");
        }
        updateSearchUI("results");
      }
    } catch (e) {
      console.error(e);
      updateSearchUI("no-results");
    }
  }

  searchInput?.addEventListener("input", (e) => {
    if (searchTimeout) clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      performSearch((e.target as HTMLInputElement).value);
    }, 250);
  });

  searchInput?.addEventListener("keydown", (e) => {
    const input = searchInput as HTMLInputElement;
    if (e.key === "Enter" && input.value.trim() !== "") {
      if (currentSelectedIndex >= 0) {
        const selected = searchResultsList?.children[
          currentSelectedIndex
        ] as HTMLElement;
        if (selected) window.location.href = selected.dataset.href as string;
      } else {
        window.location.href = `/search?q=${encodeURIComponent(input.value)}`;
      }
    }

    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      const items = searchResultsList?.children;
      if (!items || items.length === 0) return;

      if (currentSelectedIndex >= 0) {
        items[currentSelectedIndex].classList.remove(
          "bg-archive-900/60",
          "border-archive-700",
        );
        items[currentSelectedIndex].setAttribute("aria-selected", "false");
      }

      if (e.key === "ArrowDown") {
        currentSelectedIndex = (currentSelectedIndex + 1) % items.length;
      } else {
        currentSelectedIndex =
          (currentSelectedIndex - 1 + items.length) % items.length;
      }

      items[currentSelectedIndex].classList.add(
        "bg-archive-900/60",
        "border-archive-700",
      );
      items[currentSelectedIndex].setAttribute("aria-selected", "true");
      items[currentSelectedIndex].scrollIntoView({ block: "nearest" });
    }
  });

  searchResultsList?.addEventListener("click", (e) => {
    const item = (e.target as HTMLElement).closest(
      ".search-result-item",
    ) as HTMLElement | null;
    if (item && item.dataset.href) {
      window.location.href = item.dataset.href;
    }
  });
</script>
