---
import SurveyCorpsLogo from "@/assets/images/surveyCorpsLogo.svg";
import { Menu, Search } from "@lucide/astro";

const currentPath = Astro.url.pathname;

const primaryNav = [
  { href: "/search", label: "Search", number: "01" },
  { href: "/people", label: "People", number: "02" },
  { href: "/titans", label: "Titans", number: "03" },
];

const historyItems = [
  { href: "/timeline", label: "Timeline" },
  { href: "/events", label: "Events" },
  { href: "/bloodlines", label: "Bloodlines" },
];

const worldItems = [
  { href: "/locations", label: "Locations" },
  { href: "/factions", label: "Factions" },
  { href: "/objects", label: "Objects" },
  { href: "/abilities", label: "Abilities" },
];

function isActive(href: string) {
  return (
    (currentPath.startsWith(href) && href !== "/") ||
    (href === "/archive" && currentPath === "/archive")
  );
}
---

<nav
  id="global-nav"
  aria-label="Primary Navigation"
  class="group/nav fixed inset-x-0 top-0 z-70 flex -translate-y-20 items-center justify-between border-b border-transparent px-5 py-4 transition-all duration-500 sm:px-8"
>
  <div
    class="bg-archive-950/95 border-archive-800/50 shadow-heavy pointer-events-none absolute inset-0 border-b opacity-0 transition-opacity duration-500"
    id="nav-bg"
  >
  </div>

  <div class="relative z-10 flex items-center">
    <a
      href="/"
      aria-label="Home - Survey Corps Archives"
      class="group focus-visible:ring-brass-600/50 flex items-center gap-4 rounded-sm focus:outline-none focus-visible:ring-2"
    >
      <div
        class="border-archive-700/60 bg-archive-900/40 shadow-inset group-hover:border-archive-600 group-hover:bg-archive-800/60 relative flex h-10 w-10 items-center justify-center border transition-colors duration-300"
      >
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.03)_0%,transparent_100%)]"
        >
        </div>
        <img
          src={SurveyCorpsLogo.src}
          alt=""
          aria-hidden="true"
          class="h-9 w-9 opacity-60 transition-opacity duration-300 group-hover:opacity-100"
        />
      </div>
      <div class="flex flex-col justify-center">
        <span
          class="text-archive-500 group-hover:text-paper-300 font-serif text-2xl leading-none transition-colors"
        >
          AoT Archives
        </span>
      </div>
    </a>
  </div>

  <div class="relative z-10 hidden items-center gap-2 lg:flex">
    {
      primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class={`group focus-visible:ring-brass-600/50 relative flex items-baseline gap-2 rounded-sm px-4 py-2 transition-colors focus:outline-none focus-visible:ring-2 ${
            isActive(item.href)
              ? "text-paper-50"
              : "text-paper-300 hover:text-paper-100"
          }`}
        >
          <span class="text-archive-500 group-hover:text-brass-600 font-mono text-xs tracking-widest transition-colors">
            {item.number}
          </span>
          <span class="tracking-military text-[11px] font-medium uppercase">
            {item.label}
          </span>
          {isActive(item.href) && (
            <span class="bg-brass-600/50 absolute right-4 bottom-0 left-4 h-px" />
          )}
        </a>
      ))
    }

    <div class="group/dropdown relative px-2">
      <button
        type="button"
        class="group focus-visible:ring-brass-600/50 text-paper-300 hover:text-paper-100 relative flex items-baseline gap-2 rounded-sm px-4 py-2 transition-colors focus:outline-none focus-visible:ring-2"
        aria-expanded="false"
      >
        <span
          class="text-archive-500 group-hover:text-brass-600/70 font-mono text-xs tracking-widest transition-colors"
        >
          04
        </span>
        <span class="tracking-military text-[11px] font-medium uppercase">
          History
        </span>
      </button>

      <div
        class="pointer-events-none absolute top-full left-1/2 -translate-x-1/2 translate-y-2 pt-4 opacity-0 transition-all duration-300 group-hover/dropdown:pointer-events-auto group-hover/dropdown:translate-y-0 group-hover/dropdown:opacity-100 motion-reduce:transition-none"
      >
        <div
          class="border-archive-800 bg-archive-950 shadow-heavy before:bg-brass-600/50 relative w-56 border p-2 before:absolute before:-top-px before:left-1/2 before:h-px before:w-8 before:-translate-x-1/2"
        >
          <div
            class="tracking-classified text-archive-500 mb-2 px-3 pt-2 text-xs uppercase"
          >
            Timeline Records
          </div>
          <div class="flex flex-col gap-0.5">
            {
              historyItems.map((item) => (
                <a
                  href={item.href}
                  class="tracking-military text-paper-300 hover:text-paper-50 hover:bg-archive-900/50 focus-visible:ring-brass-600/50 rounded-sm px-3 py-2 text-[11px] uppercase transition-colors focus:outline-none focus-visible:ring-1"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="group/dropdown relative px-2">
      <button
        type="button"
        class="group focus-visible:ring-brass-600/50 text-paper-300 hover:text-paper-100 relative flex items-baseline gap-2 rounded-sm px-4 py-2 transition-colors focus:outline-none focus-visible:ring-2"
        aria-expanded="false"
      >
        <span
          class="text-archive-500 group-hover:text-brass-600/70 font-mono text-xs tracking-widest transition-colors"
        >
          05
        </span>
        <span class="tracking-military text-xs font-medium uppercase">
          World
        </span>
      </button>

      <div
        class="pointer-events-none absolute top-full left-1/2 -translate-x-1/2 translate-y-2 pt-4 opacity-0 transition-all duration-300 group-hover/dropdown:pointer-events-auto group-hover/dropdown:translate-y-0 group-hover/dropdown:opacity-100 motion-reduce:transition-none"
      >
        <div
          class="border-archive-800 bg-archive-950 shadow-heavy before:bg-brass-600/50 relative w-48 border p-2 before:absolute before:-top-px before:left-1/2 before:h-px before:w-8 before:-translate-x-1/2"
        >
          <div
            class="tracking-classified text-archive-500 mb-2 px-3 pt-2 text-xs uppercase"
          >
            Entities Index
          </div>
          <div class="flex flex-col gap-0.5">
            {
              worldItems.map((item) => (
                <a
                  href={item.href}
                  class="tracking-military text-paper-300 hover:text-paper-50 hover:bg-archive-900/50 focus-visible:ring-brass-600/50 rounded-sm px-3 py-2 text-[11px] uppercase transition-colors focus:outline-none focus-visible:ring-1"
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 flex items-center gap-4 sm:gap-6">
    <button
      id="search-trigger"
      type="button"
      class="group text-paper-300 hover:text-paper-100 focus-visible:ring-brass-600/50 flex items-center gap-3 rounded-sm transition-colors focus:outline-none focus-visible:ring-2"
      aria-label="Open Search"
      aria-haspopup="dialog"
    >
      <span class="hidden items-center gap-2 md:flex">
        <span class="tracking-classified text-[10px] uppercase">Search</span>
        <kbd
          class="border-archive-700 bg-archive-900/50 text-archive-500 group-hover:text-paper-300 group-hover:border-archive-600 rounded-[2px] border px-1.5 py-0.5 font-mono text-sm transition-colors"
          >⌘K</kbd
        >
      </span>
      <Search
        size={16}
        class="opacity-80 transition-opacity group-hover:opacity-100"
      />
    </button>

    <div class="bg-archive-800 hidden h-4 w-px lg:block" aria-hidden="true">
    </div>

    <button
      id="mobile-menu-trigger"
      type="button"
      class="text-paper-300 hover:text-paper-100 focus-visible:ring-brass-600/50 rounded-sm p-1 transition-colors focus:outline-none focus-visible:ring-2 lg:hidden"
      aria-label="Open Mobile Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu />
    </button>
  </div>
  <div
    class="via-brass-600/30 absolute inset-x-0 top-18 h-px bg-linear-to-r from-transparent to-transparent"
  >
  </div>
</nav>

<div
  id="search-dialog"
  role="dialog"
  aria-modal="true"
  aria-label="Search Archive"
  class="pointer-events-none fixed inset-0 z-100 flex items-start justify-center px-4 pt-[15vh] opacity-0 transition-opacity duration-300"
>
  <div
    class="bg-archive-black/80 absolute inset-0 backdrop-blur-sm transition-opacity"
    id="search-backdrop"
  >
  </div>

  <div
    class="bg-archive-950 border-archive-800 shadow-heavy relative w-full max-w-2xl scale-200 transform border opacity-0 transition-all duration-200"
    id="search-panel"
  >
    <div
      class="via-brass-600/50 absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent to-transparent"
    >
    </div>

    <div class="border-archive-800/50 flex items-center border-b px-6 py-4">
      <Search class="text-archive-500 mr-4" />
      <input
        type="text"
        id="search-input"
        class="text-paper-50 placeholder:text-archive-600 flex-1 border-none bg-transparent font-sans text-lg focus:outline-none"
        placeholder="Query archive index..."
        autocomplete="off"
      />
      <kbd
        id="search-close"
        class="text-archive-500 hover:text-paper-100 tracking-classified border-archive-800 focus-visible:ring-brass-600/50 rounded-sm border px-2 py-1 text-[11px] uppercase transition-colors focus:outline-none focus-visible:ring-2"
      >
        Esc
      </kbd>
    </div>

    <div
      class="h-[60vh] max-h-150 overflow-y-auto px-6 py-6"
      id="search-results-container"
    >
      <div
        id="search-empty-state"
        class="text-archive-500 mt-8 flex h-full flex-col items-center justify-center space-y-4 text-center"
      >
        <Search class="mb-2 opacity-100" />
        <p class="tracking-military text-[10px] uppercase">Awaiting Query</p>
      </div>
      <div
        id="search-loading-state"
        class="text-archive-500 mt-8 flex hidden h-full flex-col items-center justify-center space-y-4 text-center"
      >
        <div
          class="border-archive-700 border-t-archive-500 mb-2 h-4 w-4 animate-spin rounded-full border-2"
        >
        </div>
        <p class="tracking-military text-[10px] uppercase">
          Searching Records...
        </p>
      </div>
      <div
        id="search-no-results"
        class="text-archive-500 mt-8 flex hidden h-full flex-col items-center justify-center space-y-4 text-center"
      >
        <p class="tracking-military text-[10px] uppercase">No Records Found</p>
      </div>
      <ul
        id="search-results-list"
        class="flex hidden flex-col gap-1"
        role="listbox"
      >
      </ul>
    </div>

    <div
      class="bg-archive-900/50 border-archive-800/50 flex items-center justify-between border-t px-6 py-3"
    >
      <span class="tracking-classified text-archive-500 text-[9px] uppercase"
        >Intelligence Index</span
      >
      <span class="tracking-classified text-archive-500 text-[9px] uppercase"
        >Classified Access</span
      >
    </div>
  </div>
</div>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  class="bg-archive-950 pointer-events-none fixed inset-0 z-60 opacity-0 transition-opacity duration-300 lg:hidden"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.02)_0%,transparent_60%)]"
  >
  </div>

  <div class="flex h-full flex-col overflow-y-auto px-6 pt-24 pb-8">
    <div class="border-archive-800/50 mb-10 border-b pb-6">
      <p
        class="tracking-classified text-archive-500 mb-4 text-[10px] uppercase"
      >
        Primary Index
      </p>
      <div class="flex flex-col gap-3">
        {
          primaryNav.map((item) => (
            <a
              href={item.href}
              class="group text-paper-300 hover:text-paper-50 flex items-baseline gap-4 font-serif text-2xl transition-colors"
            >
              <span class="text-archive-600 group-hover:text-brass-600/70 font-mono text-xs tracking-widest transition-colors">
                {item.number}
              </span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="mb-auto grid grid-cols-2 gap-8">
      <div>
        <p
          class="tracking-classified text-archive-500 mb-4 text-[10px] uppercase"
        >
          History
        </p>
        <div class="flex flex-col gap-4">
          {
            historyItems.map((item) => (
              <a
                href={item.href}
                class="tracking-military text-paper-300 hover:text-paper-100 text-[11px] uppercase transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <p
          class="tracking-classified text-archive-500 mb-4 text-[10px] uppercase"
        >
          World
        </p>
        <div class="flex flex-col gap-4">
          {
            worldItems.map((item) => (
              <a
                href={item.href}
                class="tracking-military text-paper-300 hover:text-paper-100 text-[11px] uppercase transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="border-archive-800/50 flex items-center justify-between border-t pt-8"
    >
      <span
        class="tracking-classified text-archive-500 text-xs uppercase transition-colors duration-700 hover:text-zinc-200"
        >Survey Corps Records</span
      >
    </div>
  </div>
</div>
