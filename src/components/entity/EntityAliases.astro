---
import Badge from "../ui/Badge.astro";

interface Props {
  aliases: string[];
  title?: string;
  class?: string;
}

const {
  aliases,
  title = "Known Aliases & Designations",
  class: className = "",
} = Astro.props;
---

{
  aliases && aliases.length > 0 && (
    <div class={`space-y-2 ${className}`}>
      {title && (
        <span class="tracking-classified text-archive-500 block font-mono text-[10px] uppercase">
          {title}
        </span>
      )}
      <div class="flex flex-wrap items-center gap-2">
        {aliases.map((alias) => (
          <Badge variant="default" size="sm">
            {alias}
          </Badge>
        ))}
      </div>
    </div>
  )
}
