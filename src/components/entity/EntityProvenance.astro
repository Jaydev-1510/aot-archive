---
interface Props {
  sourceTitle: string;
}

const { sourceTitle } = Astro.props;
---

<section class="border-archive-800/50 mt-16 border-t pt-8">
  <div class="flex items-center gap-4">
    <div class="bg-archive-800 h-px w-8"></div>
    <span class="tracking-classified text-archive-500 text-[10px] uppercase">
      Primary Source Material
    </span>
  </div>
  <p class="text-archive-400 mt-2 pl-12 text-xs italic">
    First referenced in <span class="text-paper-300 not-italic"
      >{sourceTitle}</span
    >
  </p>
</section>
