---
interface Props {
  variant?: "text" | "card" | "dossier" | "header" | "custom";
  lines?: number;
  class?: string;
  label?: string;
}

const {
  variant = "text",
  lines = 3,
  class: className = "",
  label = "Loading archival records...",
} = Astro.props;
---

<div role="status" aria-label={label} class={`animate-pulse ${className}`}>
  {
    variant === "text" && (
      <div class="space-y-2.5">
        {Array.from({ length: lines }).map((_, i) => (
          <div
            class="bg-archive-800/60 h-3.5 rounded-[1px]"
            style={`width: ${i === lines - 1 ? "65%" : i % 2 === 0 ? "100%" : "85%"};`}
          />
        ))}
      </div>
    )
  }

  {
    variant === "card" && (
      <div class="border-archive-800/40 bg-archive-950/40 rounded-sm border p-6">
        <div class="flex items-center justify-between">
          <div class="bg-archive-800/80 h-3 w-16 rounded-[1px]" />
          <div class="bg-archive-800/50 h-3 w-8 rounded-[1px]" />
        </div>
        <div class="mt-6 space-y-2">
          <div class="bg-archive-800/80 h-6 w-3/4 rounded-[1px] font-serif" />
          <div class="bg-archive-800/50 h-4 w-1/2 rounded-[1px]" />
        </div>
        <div class="border-archive-800/30 mt-8 flex items-center justify-between border-t pt-4">
          <div class="bg-archive-800/40 h-3 w-20 rounded-[1px]" />
          <div class="bg-archive-800/40 h-3 w-12 rounded-[1px]" />
        </div>
      </div>
    )
  }

  {
    variant === "header" && (
      <div class="border-archive-800/50 space-y-4 border-b pb-8">
        <div class="flex items-center justify-between">
          <div class="bg-archive-800/80 h-3 w-28 rounded-[1px]" />
          <div class="bg-archive-800/50 h-5 w-16 rounded-sm" />
        </div>
        <div class="bg-archive-800/90 h-10 w-2/3 rounded-[1px]" />
        <div class="bg-archive-800/50 h-4 w-1/3 rounded-[1px]" />
      </div>
    )
  }

  {
    variant === "dossier" && (
      <div class="space-y-12">
        <div class="border-archive-800/50 space-y-4 border-b pb-8">
          <div class="flex items-center justify-between">
            <div class="bg-archive-800/70 h-3 w-32" />
            <div class="bg-archive-800/50 h-5 w-20" />
          </div>
          <div class="bg-archive-800/80 h-12 w-3/4" />
          <div class="bg-archive-800/50 h-5 w-1/3" />
        </div>
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
          {Array.from({ length: 4 }).map(() => (
            <div class="space-y-2">
              <div class="bg-archive-800/60 h-2.5 w-16" />
              <div class="bg-archive-800/80 h-4 w-24" />
            </div>
          ))}
        </div>
        <div class="space-y-3 pt-6">
          <div class="bg-archive-800/60 h-3.5 w-full" />
          <div class="bg-archive-800/60 h-3.5 w-5/6" />
          <div class="bg-archive-800/60 h-3.5 w-4/6" />
        </div>
      </div>
    )
  }

  {variant === "custom" && <slot />}

  <span class="sr-only">{label}</span>
</div>
